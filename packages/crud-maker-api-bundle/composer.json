{
    "name": "kematjaya/crud-maker-api-bundle",
    "description": "Symfony MakerBundle command that generates API Platform CRUD (DTO, service, state processor/extension) plus a frontend spec sidecar for @kematjaya/crud-ui-generator, for an existing Doctrine entity",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Hidayatullah",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kematjaya/crud-maker-core": "^1.0",
        "symfony/http-kernel": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/config": "^7.0|^8.0",
        "symfony/console": "^7.0|^8.0",
        "symfony/routing": "^7.0|^8.0",
        "symfony/validator": "^7.0|^8.0",
        "symfony/http-foundation": "^7.0|^8.0",
        "symfony/translation": "^7.0|^8.0",
        "symfony/yaml": "^7.0|^8.0",
        "doctrine/orm": "^3.5",
        "doctrine/doctrine-bundle": "^3.2",
        "symfony/maker-bundle": "^1.60",
        "nikic/php-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\CrudMakerBundle\\Api\\": "src/"
        }
    }
}
