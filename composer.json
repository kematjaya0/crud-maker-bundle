{
    "name": "kematjaya/crud-maker-bundle",
    "description": "crud generator base on symfony maker-bundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Hidayatullah",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "symfony/http-kernel": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/config": "^6.4",
        "symfony/console": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/validator": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/translation": "^6.4",
        "symfony/yaml": "^6.4",
        "symfony/form": "^6.4",
        "symfony/security-csrf": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/maker-bundle": "^1.50",
        "doctrine/orm": "^2.14|^3.0",
        "doctrine/doctrine-bundle": "^2.10",
        "doctrine/inflector": "^2.0",
        "kematjaya/base-controller-bundle": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/phpunit-bridge": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/var-dumper": "^6.4",
        "symfony/browser-kit": "^6.4",
        "symfony/css-selector": "^6.4",
        "symfony/process": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\CrudMakerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\CrudMakerBundle\\Tests\\": "tests/",
            "App\\": "tests/Fixtures/App/src/",
            "App\\Tests\\": "tests/Fixtures/App/tests/"
        }
    }
}
