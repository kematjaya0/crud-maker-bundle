{
    "name": "kematjaya/crud-maker-bundle",
    "description": "Umbrella package for kematjaya/crud-maker-twig-bundle and kematjaya/crud-maker-api-bundle (BC convenience: pulls in both flavors, same as before the package split). New projects should require only the flavor they need.",
    "type": "metapackage",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Hidayatullah",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kematjaya/crud-maker-core": "@dev",
        "kematjaya/crud-maker-twig-bundle": "@dev",
        "kematjaya/crud-maker-api-bundle": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/var-dumper": "^7.0|^8.0",
        "symfony/browser-kit": "^7.0|^8.0",
        "symfony/process": "^7.0|^8.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "symfony/css-selector": "^7.0|^8.0"
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "phpstan-baseline": "phpstan analyse --generate-baseline"
    },
    "scripts-descriptions": {
        "phpstan": "Runs PHPStan static analysis",
        "phpstan-baseline": "Generates PHPStan baseline for current errors"
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\CrudMakerBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
