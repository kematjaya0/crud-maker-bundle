{
    "name": "kematjaya/crud-maker-bundle",
    "description": "crud generator base on symfony maker-bundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Hidayatullah",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/http-kernel": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/config": "^7.0",
        "symfony/console": "^7.0",
        "symfony/routing": "^7.0",
        "symfony/validator": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/translation": "^7.0",
        "symfony/yaml": "^7.0",
        "symfony/form": "^7.0",
        "symfony/security-csrf": "^7.0",
        "symfony/twig-bundle": "^7.0",
        "symfony/maker-bundle": "^1.50|^1.60",
        "doctrine/orm": "^2.14|^3.0",
        "doctrine/doctrine-bundle": "^2.13|^3.0",
        "doctrine/inflector": "^2.0",
        "kematjaya/base-controller-bundle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.0|^11.0",
        "symfony/phpunit-bridge": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/var-dumper": "^7.0",
        "symfony/browser-kit": "^7.0",
        "symfony/css-selector": "^7.0",
        "symfony/process": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\CrudMakerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\CrudMakerBundle\\Tests\\": "tests/",
            "App\\": "tests/Fixtures/App/src/",
            "App\\Tests\\": "tests/Fixtures/App/tests/"
        }
    }
}
