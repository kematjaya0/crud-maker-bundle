includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
    level: 6
    paths:
        - packages/crud-maker-core/src/
        - packages/crud-maker-twig-bundle/src/
        - packages/crud-maker-api-bundle/src/
    excludePaths:
        - packages/crud-maker-twig-bundle/src/Resources/skeleton/
        - packages/crud-maker-api-bundle/src/Resources/skeleton/
